# ─── Demo mode ────────────────────────────────────────────────────────────────
# Set to "true" to use server-side keys as fallback when users don't supply theirs.
# Leave unset or "false" in production to require users to bring their own keys.
DEMO_KEYS_ENABLED=false

# Expose demo-mode flag to the client so ChatInput stays enabled.
# Must match DEMO_KEYS_ENABLED — set both or neither.
NEXT_PUBLIC_DEMO_KEYS_ENABLED=false

# ─── LLM provider (adapter swap) ──────────────────────────────────────────────
# "fireworks" runs open models via Fireworks.ai; "anthropic" runs Claude.
# These are the DEFAULTS — users can switch provider at runtime in Settings → Agent
# provider (sent per request as x-llm-provider). LLM_PROVIDER is the server fallback;
# NEXT_PUBLIC_LLM_PROVIDER is the client's initial selection. Keep them in sync.
LLM_PROVIDER=fireworks
NEXT_PUBLIC_LLM_PROVIDER=fireworks

# ─── AI keys (only needed when DEMO_KEYS_ENABLED=true) ───────────────────────
# Fireworks.ai (LLM_PROVIDER=fireworks) — https://app.fireworks.ai/settings/users/api-keys
FIREWORKS_API_KEY=fw_...

# Anthropic (LLM_PROVIDER=anthropic) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Tavily Search (web-search tool, both providers) — https://app.tavily.com
TAVILY_API_KEY=tvly-...

# ─── Model config (optional) ─────────────────────────────────────────────────
# Fireworks default (lib/config.ts): accounts/fireworks/models/minimax-m2p7  ($0.30/$1.20 per 1M)
# Alternatives: gpt-oss-20b ($0.07/$0.30), gpt-oss-120b ($0.15/$0.60), llama-v3p3-70b-instruct ($0.20/$0.80)
# FIREWORKS_MODEL=accounts/fireworks/models/minimax-m2p7

# Anthropic default (lib/config.ts): claude-sonnet-4-6  ($3/$15 per 1M). Note: claude-sonnet-5
# rejects non-default temperature, so keep 4.6 unless you also drop AGENT_TEMPERATURE.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Override Fireworks API base URL (rarely needed)
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ─── Content moderation (optional) ──────────────────────────────────────────
# When set, every message is screened by OpenAI's free moderation endpoint before
# reaching the LLM. Omit to rely on jailbreak-pattern checks only.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── LangSmith observability (optional, dev-oriented) ────────────────────────
# When these are set, LangChain automatically traces every agent run to LangSmith.
# Get a key at https://smith.langchain.com → Settings → API Keys.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=nexus-trace
#
# ⚠️ Data region: LANGSMITH_ENDPOINT defaults to the US data plane. If your workspace is
# on the EU region (its URL is eu.smith.langchain.com), you MUST set the EU endpoint below,
# or traces silently fail to upload. US: https://api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
#
# PII / privacy: LangSmith stores full run inputs AND outputs (prompts, replies, tool args
# + results) by default. To trace structure/latency/tokens without persisting content —
# safe to leave on with real users — hide the bodies (LANGCHAIN_* aliases also work):
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
#
# Base project URL for the dev-only "View in LangSmith" link in the trace panel.
# Copy it from your project page in the LangSmith UI; the run id is appended as /r/<id>.
# EU users: use the eu.smith.langchain.com host.
# NEXT_PUBLIC_LANGSMITH_PROJECT_URL=https://smith.langchain.com/o/<org>/projects/p/<project>

# ─── Rate limiting (optional) ─────────────────────────────────────────────────
# Without these, rate limiting falls back to in-memory (resets on restart — dev only).
# For production, create a free Redis DB at https://upstash.com and paste the values below.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
